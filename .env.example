# Copiar a `.env` y completar los valores. El archivo `.env` NO se versiona.

# ── Obligatorio en producción ──────────────────────────────────────
# Clave larga y aleatoria. Generar con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# Dominios reales del despliegue, separados por coma.
ALLOWED_HOSTS=localhost,127.0.0.1

# ── MercadoPago ─────────────────────────────────────────────────────
# Credenciales de la app en https://www.mercadopago.com.ar/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=
# Secreto con el que se valida la firma del webhook de notificaciones.
MERCADOPAGO_WEBHOOK_SECRET=
